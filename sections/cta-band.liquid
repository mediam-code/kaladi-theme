<section class="wrap pad-lg">
  <div class="panel panel--{{ section.settings.style }} cta-band">
    <h2 class="h-xl">{{ section.settings.heading }}</h2>
    <div class="btn-row">
      <a href="{{ section.settings.cta1_link }}" class="btn btn--lg {% if section.settings.style == 'deep' %}btn--fresh{% else %}btn--deep{% endif %}">{{ section.settings.cta1_label }}</a>
      {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_link }}" class="btn btn--lg btn--paper">{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bandă CTA",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Culoare",
      "default": "fresh",
      "options": [
        {
          "value": "fresh",
          "label": "Verde proaspăt"
        },
        {
          "value": "deep",
          "label": "Verde închis"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "Gustă recolta familiei."
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Buton 1",
      "default": "Cumpără uleiul"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Link 1",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Buton 2",
      "default": "Rezervă recolta 2027"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Link 2"
    }
  ],
  "presets": [
    {
      "name": "Bandă CTA"
    }
  ]
}
{% endschema %}
