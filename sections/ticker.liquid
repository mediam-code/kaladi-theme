<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span>{{ block.settings.text }}</span><span class="ticker__dot">✦</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Bandă avantaje",
  "blocks": [
    { "type": "item", "name": "Avantaj", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Cules cu mâna" } ] }
  ],
  "presets": [
    {
      "name": "Bandă avantaje",
      "blocks": [
        { "type": "item", "settings": { "text": "Cules cu mâna" } },
        { "type": "item", "settings": { "text": "Presat la rece" } },
        { "type": "item", "settings": { "text": "Koroneiki 100%" } },
        { "type": "item", "settings": { "text": "O singură livadă" } },
        { "type": "item", "settings": { "text": "Aur la Londra" } },
        { "type": "item", "settings": { "text": "Analize pe fiecare lot" } }
      ]
    }
  ]
}
{% endschema %}
