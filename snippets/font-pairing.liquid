{%- comment -%}
  Perechi de fonturi (Google Fonts). Se alege din Theme settings › Tipografie.
  Fiecare pereche setează: --f-display (titluri), --f-body (text), --f-accent (italic de accent),
  greutatea și spațierea titlurilor.
{%- endcomment -%}
{%- liquid
  assign pairing = settings.font_pairing | default: 'fraunces'
  case pairing
    when 'bricolage'
      assign lh_display = '0.95'
      assign families = 'family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Serif:ital@1'
      assign f_display = "'Bricolage Grotesque', sans-serif"
      assign f_body = "'Bricolage Grotesque', sans-serif"
      assign f_accent = "'Instrument Serif', serif"
      assign w_display = 800
      assign ls_display = '-0.045em'
      assign fv_display = 'normal'
    when 'fraunces'
      assign lh_display = '0.98'
      assign families = 'family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&family=Figtree:wght@400..800'
      assign f_display = "'Fraunces', serif"
      assign f_body = "'Figtree', sans-serif"
      assign f_accent = "'Fraunces', serif"
      assign w_display = 800
      assign ls_display = '-0.03em'
      assign fv_display = '"SOFT" 100, "WONK" 1'
    when 'unbounded'
      assign lh_display = '1.05'
      assign families = 'family=Unbounded:wght@400..900&family=Figtree:wght@400..800&family=Instrument+Serif:ital@1'
      assign f_display = "'Unbounded', sans-serif"
      assign f_body = "'Figtree', sans-serif"
      assign f_accent = "'Instrument Serif', serif"
      assign w_display = 800
      assign ls_display = '-0.035em'
      assign fv_display = 'normal'
    when 'syne'
      assign lh_display = '1'
      assign families = 'family=Syne:wght@400..800&family=Manrope:wght@400..800&family=Instrument+Serif:ital@1'
      assign f_display = "'Syne', sans-serif"
      assign f_body = "'Manrope', sans-serif"
      assign f_accent = "'Instrument Serif', serif"
      assign w_display = 800
      assign ls_display = '-0.03em'
      assign fv_display = 'normal'
    when 'shrikhand'
      assign lh_display = '1.08'
      assign families = 'family=Shrikhand&family=DM+Sans:opsz,wght@9..40,400..800&family=Instrument+Serif:ital@1'
      assign f_display = "'Shrikhand', serif"
      assign f_body = "'DM Sans', sans-serif"
      assign f_accent = "'Instrument Serif', serif"
      assign w_display = 400
      assign ls_display = '-0.01em'
      assign fv_display = 'normal'
    else
      assign lh_display = '0.95'
      assign families = 'family=Archivo:wdth,wght@62..125,400..900&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500'
      assign f_display = "'Archivo', sans-serif"
      assign f_body = "'Archivo', sans-serif"
      assign f_accent = "'Newsreader', serif"
      assign w_display = 900
      assign ls_display = '-0.03em'
      assign fv_display = 'normal'
  endcase
-%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ families }}&display=swap">
<style>
  :root {
    --f-display: {{ f_display }};
    --f-body: {{ f_body }};
    --f-accent: {{ f_accent }};
    --w-display: {{ w_display }};
    --ls-display: {{ ls_display }};
    --fv-display: {{ fv_display }};
    --lh-display: {{ lh_display }};
  }
</style>
