<section class="wrap pad-lg">
  <div class="faq">
    <div class="faq__head stack-md">
      <h2 class="h-xl">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead-sm">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="acc faq__list">
      {%- for block in section.blocks -%}
        <details {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }} <span aria-hidden="true">+</span></summary>
          <div>{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Întrebări frecvente",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titlu", "default": "Întrebări frecvente" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "open_first", "label": "Prima întrebare deschisă", "default": true }
  ],
  "blocks": [
    { "type": "item", "name": "Întrebare", "settings": [ { "type": "text", "id": "question", "label": "Întrebare" }, { "type": "richtext", "id": "answer", "label": "Răspuns" } ] }
  ],
  "presets": [ { "name": "Întrebări frecvente" } ]
}
{% endschema %}
