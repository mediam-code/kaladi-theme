{%- liquid
  assign p = section.settings.product
  assign v = p.selected_or_first_available_variant
  assign pct = section.settings.discount
  assign keep = 100 | minus: pct
-%}
<section class="wrap pad-lg" id="abonament">
  <div class="sub panel panel--deep" data-sub data-price="{{ v.price | default: 0 }}" data-pct="{{ pct }}">
    <div class="sub__copy">
      <span class="chip chip--fresh">{{ section.settings.eyebrow }}</span>
      <h2 class="h-xl">{{ section.settings.heading }} <em class="accent">{{ section.settings.heading_italic }}</em></h2>
      <p class="lead-sm">{{ section.settings.text }}</p>
      <ul class="sub__perks">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="sub__perk-ico" aria-hidden="true">{{ block.settings.icon }}</span>
            <span><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text }}</small></span>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="sub__card">
      <div class="sub__product">
        {%- if p != blank -%}
          <span class="sub__thumb">{{ p.featured_image | image_url: width: 240 | image_tag: alt: p.title }}</span>
          <span><small>Abonamentul tău</small><strong>{{ p.title }}</strong></span>
        {%- endif -%}
        <span class="sub__badge">−{{ pct }}%</span>
      </div>

      <div class="sub__freq" role="group" aria-label="Cât de des primești uleiul">
        <span class="sub__label">Cât de des?</span>
        <div class="sub__pills">
          <button type="button" class="sub__pill" data-freq="1" aria-pressed="false">Lunar</button>
          <button type="button" class="sub__pill" data-freq="2" aria-pressed="true">La 2 luni</button>
          <button type="button" class="sub__pill" data-freq="3" aria-pressed="false">La 3 luni</button>
        </div>
      </div>

      <div class="sub__cal" aria-hidden="true">
        <span class="sub__label">Următoarele 12 luni</span>
        <div class="sub__months" data-months>
          {%- for i in (1..12) -%}
            <span class="sub__m"><i class="sub__tin"><svg viewBox="0 0 20 28" width="18" height="25"><rect x="2" y="5" width="16" height="22" rx="2.5" fill="currentColor"/><rect x="11" y="1" width="5" height="5" rx="1" fill="currentColor"/><rect x="5" y="11" width="10" height="9" rx="1" fill="#fff" opacity=".9"/></svg></i><b></b></span>
          {%- endfor -%}
        </div>
      </div>

      <div class="sub__math">
        <div><small>Livrări pe an</small><strong data-deliveries>6</strong></div>
        <div><small>Preț pe livrare</small><strong><s data-price-full>{{ v.price | money }}</s> <span data-price-sub>{{ v.price | times: keep | divided_by: 100 | money }}</span></strong></div>
        <div class="sub__save"><small>Economisești pe an</small><strong data-save>—</strong></div>
      </div>

      <a href="{{ p.url | default: section.settings.cta_link }}" class="btn btn--fresh btn--lg btn--block" data-sub-cta>{{ section.settings.cta_label }}</a>
      <p class="sub__note">Fără angajament. Amâni, schimbi sau anulezi din cont, oricând.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Abonament (interactiv)",
  "settings": [
    { "type": "product", "id": "product", "label": "Produs de abonament" },
    { "type": "range", "id": "discount", "label": "Reducere (%)", "min": 0, "max": 30, "step": 1, "default": 10 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Abonament Kaladi" },
    { "type": "text", "id": "heading", "label": "Titlu", "default": "Uleiul vine singur." },
    { "type": "text", "id": "heading_italic", "label": "Titlu (italic)", "default": "Tu doar gătești." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Alegi cât de des, noi îl trimitem la ușă. Mereu din ultimul lot presat, mereu cu −10%." },
    { "type": "text", "id": "cta_label", "label": "Buton", "default": "Pornește abonamentul" },
    { "type": "url", "id": "cta_link", "label": "Link (dacă nu e produs)" }
  ],
  "blocks": [
    { "type": "perk", "name": "Avantaj", "settings": [ { "type": "text", "id": "icon", "label": "Simbol scurt (ex. −10%)" }, { "type": "text", "id": "title", "label": "Titlu" }, { "type": "text", "id": "text", "label": "Text" } ] }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Abonament (interactiv)" } ]
}
{% endschema %}
