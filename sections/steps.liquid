<section class="wrap pad-lg stack-md">
  <h2 class="h-xl">{{ section.settings.heading }}</h2>
  <div class="steps">
    {%- for block in section.blocks -%}
      <div class="step{% if forloop.last %} step--deep{% endif %}" {{ block.shopify_attributes }}>
        <span class="step__num">{{ forloop.index }}</span>
        <strong>{{ block.settings.title }}</strong>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Pași",
  "settings": [ { "type": "text", "id": "heading", "label": "Titlu", "default": "De la ram la masa ta, în 4 pași." } ],
  "blocks": [
    { "type": "step", "name": "Pas", "settings": [ { "type": "text", "id": "title", "label": "Titlu" }, { "type": "textarea", "id": "text", "label": "Text" } ] }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Pași",
      "blocks": [
        { "type": "step", "settings": { "title": "O singură livadă", "text": "3.000+ măslini Koroneiki, la 400 m altitudine, lângă Kalamata." } },
        { "type": "step", "settings": { "title": "Cules cu mâna", "text": "Decembrie–ianuarie. Fără pesticide, doar îngrășăminte organice." } },
        { "type": "step", "settings": { "title": "Presat în 12 ore", "text": "La rece, sub 27°C, în presă certificată ecologic. Nefiltrat." } },
        { "type": "step", "settings": { "title": "La tine în 24–48 h", "text": "Cu data recoltei și buletinul de analiză al lotului." } }
      ]
    }
  ]
}
{% endschema %}
