<section class="wrap pad-sm" id="poveste">
  <div class="panel panel--deep stack-lg">
    <div class="section-head">
      <h2 class="h-xl">{{ section.settings.heading }} <em class="accent">{{ section.settings.heading_italic }}</em></h2>
      <a href="{{ section.settings.cta_link }}" class="btn btn--fresh">{{ section.settings.cta_label }}</a>
    </div>
    <div class="duo">
      {%- for block in section.blocks -%}
        {%- if block.type == 'person' -%}
          <figure class="person" {{ block.shopify_attributes }}>
            <div class="person__media">
              {%- render 'kimg', image: block.settings.image, fallback: block.settings.fallback_asset, alt: block.settings.name, width: 1000 -%}
              {%- if block.settings.note != blank -%}<span class="chip chip--deep person__note">{{ block.settings.note }}</span>{%- endif -%}
            </div>
            <blockquote>„{{ block.settings.quote }}”</blockquote>
            <figcaption>{{ block.settings.name }}</figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="stats">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="stat" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Povestea",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "Un român. O familie din Kalamata."
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Titlu (italic)",
      "default": "Un singur ulei."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Buton",
      "default": "Povestea întreagă"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link buton"
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Persoană",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Imagine din temă (fallback)"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Notă peste foto"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Citat"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nume și rol"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Cifră",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Valoare"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etichetă"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Povestea"
    }
  ]
}
{% endschema %}
