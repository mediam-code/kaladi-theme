<section class="wrap pad-lg split">
  <div class="stack-md split__text">
    <h2 class="h-xl">{{ section.settings.heading }} <em>{{ section.settings.heading_italic }}</em></h2>
    <p class="lead-sm">{{ section.settings.text }}</p>
    <div class="awards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'award' -%}
          <div class="award" {{ block.shopify_attributes }}>
            {%- render 'kimg', image: block.settings.image, fallback: block.settings.fallback_asset, alt: block.settings.title, width: 160 -%}
            <span><strong>{{ block.settings.title }}</strong><br>{{ block.settings.sub }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="lot-card">
    <div class="lot-card__inner">
      <div class="lot-card__head"><strong>Fișa lotului</strong><span class="chip chip--deep">Lot #{{ section.settings.lot_code }}</span></div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <div class="lot-row" {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><strong>{{ block.settings.value }}</strong></div>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.pdf != blank -%}
        <a href="{{ section.settings.pdf }}" class="btn btn--deep btn--block">Descarcă buletinul (PDF)</a>
      {%- else -%}
        <span class="btn btn--deep btn--block" aria-disabled="true">Descarcă buletinul (PDF)</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Transparență / lot",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titlu", "default": "Nu ne crezi pe cuvânt?" },
    { "type": "text", "id": "heading_italic", "label": "Titlu (italic)", "default": "Perfect." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Scanezi codul de pe sticlă și vezi buletinul de analiză al lotului tău." },
    { "type": "text", "id": "lot_code", "label": "Cod lot", "default": "[cod]" },
    { "type": "url", "id": "pdf", "label": "Link PDF buletin" }
  ],
  "blocks": [
    { "type": "award", "name": "Premiu", "settings": [ { "type": "image_picker", "id": "image", "label": "Badge" }, { "type": "text", "id": "fallback_asset", "label": "Badge din temă" }, { "type": "text", "id": "title", "label": "Titlu" }, { "type": "text", "id": "sub", "label": "Subtitlu" } ] },
    { "type": "row", "name": "Rând analiză", "settings": [ { "type": "text", "id": "label", "label": "Parametru" }, { "type": "text", "id": "value", "label": "Valoare" } ] }
  ],
  "presets": [ { "name": "Transparență / lot" } ]
}
{% endschema %}
