<section class="wrap pad-md">
  <div class="panel panel--fresh panel--tight split">
    <div class="media-round media-round--inner">
      {%- render 'kimg', image: section.settings.image, fallback: 'ai-olive-grove.jpg', alt: 'Livada de măslini din Messinia la apus', width: 1400 -%}
    </div>
    <div class="stack-md split__text pad-inner">
      <span class="chip chip--deep">{{ section.settings.eyebrow }}</span>
      <h2 class="h-lg">{{ section.settings.heading }}</h2>
      <p class="lead-sm">{{ section.settings.text }}</p>
      <a href="{{ section.settings.cta_link }}" class="btn btn--deep">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Origine",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagine"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "De unde vine"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "O livadă la 400 m, la 30 km de Kalamata."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Familia Nikolopoulos culege cu mâna și presează în maximum 12 ore. Kaladi aduce în România doar uleiul lor."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Buton",
      "default": "Cunoaște familia"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Origine"
    }
  ]
}
{% endschema %}
